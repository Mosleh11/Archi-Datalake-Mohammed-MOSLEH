refresh [label="refresh\n(vide)"]; "bronze/tpcxbb" [label="tpcxbb\n(vide)"]; silver [label="silver\n(vide)"]; gold [label="gold\n(vide)"]; quality [label="quality\n(vide)"]; logs [label="logs\n(vide)"];
